# Dedicated disposable PDF parser image; no application code or credentials.
# Pin Python and pypdf to reproducible build inputs in this development image.
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN python -m pip install --no-cache-dir --disable-pip-version-check "pypdf==6.21.2"

WORKDIR /opt/tramitia
COPY --chown=65534:65534 app/pdf_worker.py /opt/tramitia/pdf_worker.py

# Execution is further restricted by app/pdf_processing.py (docker run options).
USER 65534:65534
ENTRYPOINT ["python", "-I", "/opt/tramitia/pdf_worker.py"]
