# Reference only. Requires a non-root tramitia-web OS account with NO
# membership in docker or other privileged groups.
[Unit]
Description=TramitIA FastAPI (nonprivileged web account)
Requires=tramitia-pdf-broker.service
After=tramitia-pdf-broker.service network.target

[Service]
Type=exec
User=tramitia-web
Group=tramitia-web
WorkingDirectory=/opt/tramitia
EnvironmentFile=/etc/tramitia/web.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TRAMITIA_DEPLOYMENT_PROFILE=isolated
Environment=TRAMITIA_PDF_WORKER_BACKEND=broker
Environment=TRAMITIA_BROKER_SOCKET=/run/tramitia/pdf-broker.sock
ExecStart=/opt/tramitia/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-proxy-headers --log-level warning
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateTmp=true
PrivateDevices=true
InaccessiblePaths=-/run/docker.sock
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryMax=768M
TasksMax=64
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
